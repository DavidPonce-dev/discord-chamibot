{
  "name": "charmin-charmeleon",
  "version": "1.5.4",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation tsx src/index.ts",
    "build": "rimraf dist && tsc && tsc-alias && shx cp src/infra/http/admin-page.html dist/infra/http/",
    "start": "NODE_OPTIONS=--no-deprecation node dist/index.js",
    "register": "tsx src/register.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "http-proxy": "^1.18.1",
    "lastfm-ts-api": "^2.6.2",
    "play-dl": "^1.9.7",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.0",
    "shx": "^0.4.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  }
}
