# ============================================
# Discord Bot - Environment Variables
# ============================================

# --- Discord (REQUIRED) ---
# Bot token from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Application Client ID from: Developer Portal > General Information
CLIENT_ID=your_client_id_here

# --- Admin Panel ---
# Access token for the admin HTTP server
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=your_admin_token_here

# CORS allowed origins (comma-separated)
ADMIN_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin server port (default: 3002)
# ADMIN_PORT=3002

# --- YouTube Cookies ---
# Directory to store cookie files (default: data/cookies)
# COOKIE_DIR=data/cookies

# Browser profile directory for Playwright (default: data/browser-profile)
# BROWSER_PROFILE=data/browser-profile

# Cookie auto-refresh interval in ms (default: 1800000 = 30 min)
# COOKIE_REFRESH_INTERVAL_MS=1800000

# --- VNC (for interactive cookie login) ---
# VNC web access port (default: 6080)
# VNC_PORT=6080

# --- Last.fm (optional, for radio recommendations) ---
# Get an API key from: https://www.last.fm/api/account/create
# LASTFM_API_KEY=

# --- Groq AI (optional, for LLM-based recommendations) ---
# Get an API key from: https://console.groq.com
# GROQ_API_KEY=
